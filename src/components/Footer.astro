---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <ul class="footer-links">
      <li>
        <a href={site.social.github} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 3.8 5.4 4.1 5.4 4.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 10.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
            ></path>
          </svg>
          GitHub
        </a>
      </li>
      <li>
        <a href={site.social.linkedin} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.social.youtube} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"
            ></path>
            <path d="m10 15 5-3-5-3z"></path>
          </svg>
          YouTube
        </a>
      </li>
      <li>
        <a href="#top">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12 7-7 7 7M12 19V5"></path>
          </svg>
          Back to top
        </a>
      </li>
    </ul>

    <p>&copy; {year} {site.name}</p>
  </div>
</footer>
