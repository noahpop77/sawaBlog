---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const lastUpdate = "November 16, 2026";
---

<BaseLayout title={`Now — ${site.name}`} description="What I'm doing now.">
  <header class="shell page-head">
    <h1>Now</h1>
    <p>Here&rsquo;s what keeps me busy at the moment.</p>
  </header>

  <div class="shell now-content">
    <p class="now-meta">
      Last update: <time datetime="2026-11-16">{lastUpdate}</time>
    </p>
    <p>
    I am currently workong on <a href="https://github.com/noahpop77/Hermes">Hermes</a>.
    It will become a platform similar to my <a href="https://github.com/noahpop77/Olympus">Olympus</a>
    in that it will serve as a scalable test suite for virtualized and possibly physical
    end to end testing of generated/rendered video frames and performance measurements.

    <br>
    <br>

    Basically a low latency video pipeline I can mess around with. Written in C.
    
    </p>

    <h2>Working on</h2>
    <ul>
      <li>List a project or goal you are actively working on.</li>
      <li>Add another one.</li>
      <li>Keep this list short and honest.</li>
    </ul>

    <h2>Reading, watching, listening</h2>
    <p>
      Add a book, show, album, or podcast you are into right now. Or delete this
      section if it does not fit.
    </p>
  </div>
</BaseLayout>
