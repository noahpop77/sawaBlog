---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MomentCard from "../../components/MomentCard.astro";
import { getCollection } from "astro:content";
import { formatMomentDate } from "../../lib/format";

export async function getStaticPaths() {
  const moments = await getCollection("moments");
  return moments.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const title = formatMomentDate(entry.data.date);
---

<BaseLayout title={`Moment — ${title}`} description="A moment.">
  <div class="shell">
    <a class="back-link" href="/moments">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m12 19-7-7 7-7M19 12H5"></path>
      </svg>
      See all moments
    </a>

    <MomentCard entry={entry} />
  </div>
</BaseLayout>
