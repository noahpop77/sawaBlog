---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byNewest, formatShortDate } from "../../lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(byNewest);

const groups = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  const list = groups.get(year) ?? [];
  list.push(post);
  groups.set(year, list);
}
const years = [...groups.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="Blog" description="Posts, articles, and notes.">
  <header class="shell page-head">
    <h1>Blog</h1>
    <p>Posts, articles, and notes I&rsquo;ve written over the years.</p>
  </header>

  <div class="shell archive">
    {
      years.length > 0 ? (
        years.map(([year, yearPosts]) => (
          <section class="year-group">
            <h2 class="year-label">{year}</h2>
            <ul class="post-list">
              {yearPosts.map((post) => (
                <li>
                  <a class="post-row" href={`/blog/${post.id}`}>
                    <span class="title">
                      {post.data.title}
                      <span class="leader" aria-hidden="true"></span>
                    </span>
                    <time class="date" datetime={post.data.date.toISOString()}>
                      {formatShortDate(post.data.date)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="empty-state">No posts yet. The first one is on its way.</p>
      )
    }
  </div>
</BaseLayout>
